# Copy this file to .env and fill in your own values.

# SQLite works locally; use a Postgres URL for a cloud database, e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///app.db

# Use long random strings, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string

# Optional: paths to TLS certificates for HTTPS (see README)
# SSL_CERT=cert.pem
# SSL_KEY=key.pem
